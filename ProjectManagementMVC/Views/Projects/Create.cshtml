@model ProjectForm
@{ ViewData["Title"] = "Lisää projekti"; }
<h1>@ViewData["Title"]</h1>
<div class="row"><div class="col-md-7 col-lg-6">
    @* Form Tag Helper tuottaa myös CSRF-suojauksen vaatiman piilokentän. *@
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <partial name="_Fields" model="Model" />
        <button type="submit" class="btn btn-primary">Tallenna</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Peruuta</a>
    </form>
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
