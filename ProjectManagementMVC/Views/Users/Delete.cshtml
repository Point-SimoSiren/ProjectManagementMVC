@model User
@{ ViewData["Title"] = "Poista käyttäjä"; }
<h1>@ViewData["Title"]</h1>
<p>Haluatko varmasti poistaa tämän tietueen?</p>
@if (Model.Projects.Count > 0 || Model.Tasks.Count > 0)
{
    <div class="alert alert-warning">Käyttäjään liittyy projekteja tai tehtäviä. Siirrä ne toiselle käyttäjälle tai poista ne ensin.</div>
}
<partial name="_Details" model="Model" />
<form asp-action="Delete" asp-route-id="@Model.UserId" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <button type="submit" class="btn btn-danger">Vahvista poisto</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Peruuta</a>
</form>
